    defaultLobbySprite: {fileID: 0}
    entries:
    - text: "\uC2A4\uD3F0\uC11C \uBA38\uB2C8 \uBC14\uB2E5\uB0AC\uC5B4! \uACF5\uC9DC
        \uB808\uC774\uC2A4\uB294 \uC5C6\uAC70\uB4E0?"
      lobbySprite: {fileID: 0}
      portraitSprite: {fileID: 0}
    - text: "\uAE30\uB984\uAC12\uB3C4 \uC5C6\uC73C\uBA74\uC11C \uD480 \uD29C\uB2DD\uC744
        \uD558\uACA0\uB2E4\uACE0? \uC0C1\uAE08\uBD80\uD130 \uBC8C\uC5B4\uC640!"
      lobbySprite: {fileID: 0}
      portraitSprite: {fileID: 0}
    lines: []
  slotUnavailable:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 8940279900342473803, guid: 1cfd2bf9f532755419de4d67904aab53, type: 3}
    defaultLobbySprite: {fileID: 0}
    entries:
    - text: "\uADF8\uB9AC\uB4DC \uB9CC\uC11D\uC774\uC57C! \uB354 \uB07C\uC5B4\uB4E4
        \uC790\uB9AC\uAC00 \uC5C6\uC796\uC544!"
      lobbySprite: {fileID: 0}
