  m_Script: {fileID: 11500000, guid: 41f22804cb10a1c43b4e6046ac101249, type: 3}
  m_Name: OperatorDialogueSet
  m_EditorClassIdentifier: Assembly-CSharp::RCCom.UI.OperatorDialogueSet
  lobbyIdleSprite: {fileID: 5771864889448805728, guid: 5b49084e49d23c9439bdffe7e3b23f8f, type: 3}
  idleSprite: {fileID: 0}
  lobbyInteraction:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 0}
    defaultLobbySprite: {fileID: -8842975215526782624, guid: 770f7d05d59fe974faf04c678dd83b08, type: 3}
    entries:
    - text: "\uC5D4\uC9C4 \uC608\uC5F4\uC740 \uB05D\uB0AC\uC5B4, \uB4DC\uB77C\uC774\uBC84!
        \uC5B8\uC81C \uC11C\uD0B7\uC73C\uB85C \uB098\uAC08 \uAC70\uC57C?"
      lobbySprite: {fileID: -8842975215526782624, guid: 770f7d05d59fe974faf04c678dd83b08, type: 3}
      portraitSprite: {fileID: 0}
    - text: "\uC5B4\uBA38, \uD0C0\uC774\uC5B4 \uACF5\uAE30\uC555\uC774\uB77C\uB3C4
        \uCCB4\uD06C\uD574 \uC8FC\uB824\uACE0? \uACE0\uB9C8\uC6CC\uB77C~"
      lobbySprite: {fileID: 9085980035291716299, guid: 9422c5807b3ab134ebfc2bec96cd9633, type: 3}
      portraitSprite: {fileID: 0}
    lines: []
  lobbyReturnTogether:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 0}
    defaultLobbySprite: {fileID: 4862259520954443468, guid: 8bfe9ff2970fb76479bce7356e1d85b0, type: 3}
    entries:
    - text: "\uCD5C\uACE0 \uAE30\uB85D \uAC31\uC2E0\uC774\uC57C! \uC5ED\uC2DC \uB0B4
        \uC804\uB2F4 \uB4DC\uB77C\uC774\uBC84 \uB2E4\uC6B4 \uC644\uBCBD\uD55C \uCF54\uB108\uB9C1\uC774\uC5C8\uC5B4!"
      lobbySprite: {fileID: 4862259520954443468, guid: 8bfe9ff2970fb76479bce7356e1d85b0, type: 3}
      portraitSprite: {fileID: 0}
    - text: "\uBD24\uC9C0? \uAD00\uC911\uB4E4 \uD658\uD638\uC131 \uD130\uC9C0\uB294
        \uAC70! \uB2E4\uC74C \uC11C\uD0B7\uC5D0\uC11C\uB3C4 \uC774 \uAE30\uC138\uB85C
        1\uB4F1 \uB530\uB0B4\uC790\uACE0!"
      lobbySprite: {fileID: 3197500064403587243, guid: 2d81fcded81d9444887bc5b5a628abf5, type: 3}
      portraitSprite: {fileID: 0}
    lines: []
  lobbyReturn:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 0}
    defaultLobbySprite: {fileID: 2930691584566479702, guid: cb192b563338282478d9b9f17a34a745, type: 3}
    entries:
    - text: "\uD63C\uC790\uC11C\uB9CC \uC11C\uD0B7 \uB2EC\uB9AC\uACE0 \uC628 \uAC70\uC57C?
        \uCE58\uC0AC\uD558\uAC8C\u2026"
      lobbySprite: {fileID: 2930691584566479702, guid: cb192b563338282478d9b9f17a34a745, type: 3}
      portraitSprite: {fileID: 0}
    - text: "\uD558\uC544\uC554\u2026 \uB108\uAC00 \uC5C6\uC73C\uB2C8\uAE4C \uD53C\uD2B8\uAC00
        \uB108\uBB34 \uC370\uB801\uD574. \uB2E4\uC74C\uC5D4 \uB098\uB3C4 \uAF2D \uD0DC\uC6CC\uC8FC\uB294
        \uAC70\uC9C0?"
      lobbySprite: {fileID: -9083216213319132635, guid: 61856640705cc044d9b38dd703936aa7, type: 3}
      portraitSprite: {fileID: 0}
    - text: "\uBB34\uC0AC\uD788 \uD53C\uD2B8\uC778\uD588\uB124. \u2026\uB531\uD788
        \uAC71\uC815\uD55C \uAC74 \uC544\uB2C8\uAC70\uB4E0? \uD0C0\uC774\uC5B4 \uC0C1\uD0DC\uB098
        \uCCB4\uD06C\uD574 \uBD10."
      lobbySprite: {fileID: -4277495890944506689, guid: 93bf4c9ebc5328144ad38b56c3fa1f01, type: 3}
      portraitSprite: {fileID: 0}
    lines: []
  lobbyTouchUnfamiliar:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 0}
    defaultLobbySprite: {fileID: -9083216213319132635, guid: 61856640705cc044d9b38dd703936aa7, type: 3}
    entries:
    - text: "\uCC28\uCCB4 \uC810\uAC80? \u2026\uADF8\uB7F0 \uB208\uBE5B\uC73C\uB85C
        \uBCF4\uBA74 \uD0C0\uC774\uC5B4 \uC628\uB3C4\uB9CC \uC62C\uB77C\uAC00\uB294\uB370."
      lobbySprite: {fileID: -9083216213319132635, guid: 61856640705cc044d9b38dd703936aa7, type: 3}
      portraitSprite: {fileID: 0}
    - text: "\uC7A1\uB2F4\uD560 \uC2DC\uAC04 \uC788\uC73C\uBA74 \uCF54\uC2A4 \uC8FC\uD589
        \uB77C\uC778\uC774\uB098 \uB354 \uC678\uC6B0\uACE0 \uC624\uC9C0 \uADF8\uB798?"
      lobbySprite: {fileID: -8069811602518966249, guid: 00a13e5a9953e184192b0575b1ea8c83, type: 3}
      portraitSprite: {fileID: 0}
    lines: []
  lobbyTouchFavorable:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 0}
    defaultLobbySprite: {fileID: 5771864889448805728, guid: 5b49084e49d23c9439bdffe7e3b23f8f, type: 3}
    entries:
    - text: "\uD6C4\uD6D7, \uBC18\uC751 \uC18D\uB3C4\uAC00 \uC81C\uBC95 \uBE60\uB978\uB370?
        \uAF64 \uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uD398\uC774\uC2A4\uC57C."
      lobbySprite: {fileID: 5771864889448805728, guid: 5b49084e49d23c9439bdffe7e3b23f8f, type: 3}
      portraitSprite: {fileID: 0}
    lines: []
  lobbyTouchJoy:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 0}
    defaultLobbySprite: {fileID: 3197500064403587243, guid: 2d81fcded81d9444887bc5b5a628abf5, type: 3}
    entries:
    - text: "\uB0B4 \uAE43\uBC1C\uC740 \uC624\uC9C1 1\uB4F1\uD55C\uD14C\uB9CC \uD754\uB4DC\uB294
        \uBC95\uC774\uC57C. \uADF8\uB9AC\uACE0 \uC9C0\uAE08 1\uB4F1\uC740\u2026 \uB2F9\uC5F0\uD788
        \uB108\uC9C0!"
      lobbySprite: {fileID: 3197500064403587243, guid: 2d81fcded81d9444887bc5b5a628abf5, type: 3}
      portraitSprite: {fileID: 0}
    - text: "\uC5B4\uBA38, \uAC11\uC790\uAE30 \uD130\uCE58\uB77C\uB2C8\u2026 \uD53C\uD2B8\uC2A4\uD1B1
        \uC2E0\uD638\uB3C4 \uC5C6\uC774 \uB4E4\uC774\uB300\uBA74 \uBC18\uCE59\uC774\uAC70\uB4E0?
        \uD6C4\uD6D7~"
      lobbySprite: {fileID: 7689553402402167601, guid: f2b5d6b407e2f58428ab5fdbfac14aab, type: 3}
      portraitSprite: {fileID: 0}
    lines: []
  lobbyTouchLove:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 0}
    defaultLobbySprite: {fileID: -6014986634922982624, guid: 9d31303b53e18084c91a9067792d8bb2, type: 3}
    entries:
    - text: "\uB108\uB791 \uD568\uAED8\uB77C\uBA74 \uC5B4\uB5A4 \uC704\uD5D8\uD55C
        \uCF54\uB108\uB77C\uB3C4 \uBE0C\uB808\uC774\uD06C \uC5C6\uC774 \uAEBE\uC744
        \uC218 \uC788\uC744 \uAC83 \uAC19\uC544."
      lobbySprite: {fileID: -6014986634922982624, guid: 9d31303b53e18084c91a9067792d8bb2, type: 3}
      portraitSprite: {fileID: 0}
    - text: "\uC190\u2026 \uADF8\uB807\uAC8C \uB365\uC11D \uC7A1\uC73C\uBA74 \uC5D4\uC9C4
        RPM\uC774 \uD55C\uACC4\uCE58\uAE4C\uC9C0 \uCE58\uC19F\uC796\uC544\u2026 \uBC14\uBCF4\uC57C."
      lobbySprite: {fileID: -4277495890944506689, guid: 93bf4c9ebc5328144ad38b56c3fa1f01, type: 3}
      portraitSprite: {fileID: 0}
    - text: "\uC2A4\uD3EC\uD2B8\uB77C\uC774\uD2B8 \uB530\uC704 \uC5C6\uC5B4\uB3C4
        \uB3FC. \uB0B4 \uC11C\uD0B7\uC758 \uC720\uC77C\uD55C \uC8FC\uC778\uACF5\uC740\u2026
        \uC624\uC9C1 \uB108 \uD558\uB098\uBFD0\uC774\uB2C8\uAE4C."
      lobbySprite: {fileID: 4398698445811061806, guid: 2b327dc40c066034fac6b4d3e9cdbf8a, type: 3}
      portraitSprite: {fileID: 0}
    lines: []
  lobbyTouchEx:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 0}
    defaultLobbySprite: {fileID: -2309682659725721124, guid: 6d6990a1acad5e6419320280d3d195a2, type: 3}
    entries:
    - text: "\uC5D4\uC9C4 \uC18C\uB9AC\uBCF4\uB2E4... \uB124 \uC190\uAE38\uC5D0 \uB6F0\uB294
        \uB0B4 \uC2EC\uC7A5 \uC18C\uB9AC\uAC00 \uD6E8\uC52C \uB354 \uD06C\uAC8C \uB4E4\uB824.
        \uC601\uD6E4\uD788 \uB0B4 \uC11C\uD0B7\uC5D0 \uBA38\uBB3C\uB7EC \uC904 \uAC70\uC9C0?"
      lobbySprite: {fileID: 4398698445811061806, guid: 2b327dc40c066034fac6b4d3e9cdbf8a, type: 3}
      portraitSprite: {fileID: 0}
    - text: "\uCCB4\uCEE4 \uD50C\uB798\uADF8\uAC00 \uB0B4\uB824\uC640\uB3C4 \uC6B0\uB9AC\uC758
        \uB808\uC774\uC2A4\uB294 \uB05D\uB098\uC9C0 \uC54A\uC544. \uD3C9\uC0DD \uD480
        \uC545\uC140\uB85C \uB098\uC640 \uD568\uAED8 \uB2EC\uB824\uC918."
      lobbySprite: {fileID: -6014986634922982624, guid: 9d31303b53e18084c91a9067792d8bb2, type: 3}
      portraitSprite: {fileID: 0}
    lines: []
