  m_EditorClassIdentifier: Assembly-CSharp::RCCom.Definitions.Operator.OperatorDefinition
  operatorId: racing
  displayName: "\uC2E4\uBE44\uC544"
  playStyleDescription: "\uB808\uC774\uC2F1\uAC78 \uCEE8\uC149\uC758 \uCE90\uB9AD\uD130"
  selectionPortrait: {fileID: -5444712353710830913, guid: a13fbdb6118b92346afad784d8f984f9, type: 3}
  managementPortrait: {fileID: 4831207923975717834, guid: 86f456bec9ddbf940b3f7d082e6425a3, type: 3}
  shopPortrait: {fileID: 4831207923975717834, guid: 86f456bec9ddbf940b3f7d082e6425a3, type: 3}
  shopUpperBodyPortrait: {fileID: 5213403170487169785, guid: f025c6e990d1a354891fb2f4188bab81, type: 3}
  shopUpperBodyPortraitDimmed: {fileID: 4485910227987535040, guid: f079c1ff310953f48a5c5772d15af6a2, type: 3}
  alternateName: Racer
  shopDialogue: "Get, Set, GO!\n\uB2EC\uB824\uBCFC\uAE4C, \uAC10\uB3C5\uAD00!"
  codename: Racer
  role: "R&C \uCEF4\uD37C\uB2C8 \uC624\uD37C\uB808\uC774\uD130"
  faction: "R&C \uCEF4\uD37C\uB2C8"
  height: 168cm
  birthday: 1/19
  speciality: "\uB808\uC774\uC2F1"
  weapon: "M1911 \uAD8C\uCD1D '\uC564\uD2F0\uD06C'"
  origin: "\uC544\uCE78\uC18C \uC8FC, \uBBF8\uD569\uC911\uAD6D"
  bondRecords:
  - description: "\uC774\uB984 : \uC2E4\uBE44\uC544 (Sylvia / \uC131\uC528 \uBD88\uC0C1)\r\n\uB098\uC774
      : 20\uC138\r\n\uC2E0\uC7A5/\uCCB4\uC911 : 168cm / 52kg\r\n\uD65C\uB3D9 \uC9C0\uC5ED
      : \uCE7C\uB9AC\uC2A4\uD0C4 \uACF5\uD654\uAD6D. R&C \uCEF4\uD37C\uB2C8 \uAE30\uB3D9
      \uAD00\uC81C \uAD6C\uC5ED\r\n\uC18D\uC131 : \uD63C\uB3C8 \uC120 (Chaotic Good)\r\n\r\n\"Get,
      Set, GO!\n\uB2EC\uB824\uBCFC\uAE4C, \uAC10\uB3C5\uAD00!\""
  - description: "\uD559\uC0DD \uC2DC\uC808\uBD80\uD130 \uBBF8 \uB0A8\uBD80 \uC804\uC5ED\uC758
      \uD2B8\uB799\uC744 \uD729\uC4F8\uBA70 '\uC544\uCE78\uC18C\uC758 \uCCAD\uC0C9
      \uBC88\uAC1C'\uB85C \uBD88\uB9AC\uB358 \uCC9C\uC7AC \uB808\uC774\uC11C. \uBBF8\uAD6D
      \uB0A8\uBD80\uC5D0 \uB9CC\uC5F0\uD55C \uC2EC\uAC01\uD55C \uB0A8\uB140\uCC28\uBCC4\uC5D0\uB3C4
      \uBD88\uAD6C\uD558\uACE0 \uB530\uB0B8 \uAE30\uB150\uBE44\uC801\uC778 \uC131\uACFC\uC600\uB2E4.\r\n\r\n\uB610\uD55C,
      \uC0B0\uC804\uC218\uC804 \uB2E4 \uACAA\uC740 \uAD70\uC778\uACFC \uCCA9\uBCF4\uC6D0\uB4E4\uC774
      \uC990\uBE44\uD55C R&C \uCEF4\uD37C\uB2C8\uC5D0\uC11C \uBCF4\uAE30 \uB4DC\uBB3C\uAC8C
      \uC21C\uC218\uD55C \uBBFC\uAC04\uC778 \uCD9C\uC2E0\uC774\uB2E4.\r\n\r\n\uC81C3\uCC28
      \uBBF8\uAD6D \uB0B4\uC804\uC774 \uBC1C\uBC1C\uD558\uACE0 \uACE0\uD5A5 \uC544\uCE78\uC18C
      \uC77C\uB300\uC5D0 \uC5F0\uBC29\uAD70\uC774 \uB4E4\uC774\uB2E5\uCE58\uACE0
      \uC560\uC9C0\uC911\uC9C0\uD558\uB358 \uC11C\uD0B7\uACFC \uCC28\uACE0\uAC00
      \uC7BF\uB354\uBBF8\uB85C \uBCC0\uD574\uBC84\uB9AC\uC790, \uAC00\uC871\uACFC
      \uD568\uAED8 \uBB34\uC791\uC815 \uD53C\uB09C\uC744 \uB5A0\uB0AC\uB2E4.\r\n\r\n\uD2B9\uC720\uC758
      \uBC1D\uACE0 \uC2DC\uC6D0\uC2DC\uC6D0\uD55C \uB0A8\uBD80 \uC544\uAC00\uC528\uC758
      \uC5D0\uB108\uC9C0\uB85C \uCEA0\uD504 \uC8FC\uBCC0\uC744 \uD658\uD558\uAC8C
      \uBC1D\uD788\uBA70, \uAC10\uB3C5\uAD00\uC744 \uC790\uC2E0\uC758 '\uC804\uB2F4
      \uB4DC\uB77C\uC774\uBC84'\uB85C \uC0C1\uB2F9\uD55C \uD765\uBBF8\uB97C \uBCF4\uC774\uACE0
      \uC788\uB2E4."
  - description: "\uADF8\uB140\uC758 \uACBD\uC774\uB85C\uC6B4 \uBC18\uC0AC\uC2E0\uACBD\uACFC
      \uCF54\uB108\uB9C1 \uAC10\uAC01\uC740 \uB2E8\uC21C\uD55C \uC7AC\uB2A5\uC744
      \uB118\uC5B4, \uC2E0\uCCB4 \uB0B4\uC5D0\uC11C \uBC1C\uD765\uD558\uAE30 \uC2DC\uC791\uD55C
      \uBBF8\uC57D\uD55C '\uACBD\uACC4\uACF5\uBA85 \uB2A5\uB825'\uC758 \uC870\uC9D0\uC73C\uB85C
      \uBC1D\uD600\uC84C\uB2E4.\r\n\uC804\uC7A5\uC5D0\uC11C \uBE57\uBC1C\uCE58\uB294
      \uD3EC\uD654\uC640 \uC801\uB4E4\uC758 \uAE30\uC2B5\uC870\uCC28 \uB3D9\uBB3C\uC801\uC778
      \uC9C1\uAC10\uC73C\uB85C \uD53C\uD574\uB0B4\uB294 \uD0C1\uC6D4\uD55C \uC0AC\uC120
      \uD68C\uD53C\uB825\uC744 \uC790\uB791\uD55C\uB2E4. \r\n\uAD70\uC0AC \uD6C8\uB828\uC744
      \uBC1B\uC9C0 \uC54A\uC740 \uC77C\uBC18\uC778\uC774\uAE30\uC5D0 \uC804\uC7C1\uD130\uC758
      \uACF5\uD3EC\uB97C \uC11C\uD0B7\uC758 \uC5D4\uC9C4 \uBC30\uAE30\uC74C\uC73C\uB85C
      \uC560\uC368 \uCE58\uD658\uD558\uBA70 \uBC84\uD2F0\uACE0 \uC788\uC9C0\uB9CC,
      \uBC24\uC774 \uB418\uBA74 \uBD88\uD0C0\uB358 \uACE0\uD5A5 \uD2B8\uB799\uC758
      \uC545\uBABD\uC5D0 \uC2DC\uB2EC\uB9AC\uACE4 \uD55C\uB2E4.\n\n\uACB0\uAD6D \uADF8\uB140
      \uB610\uD55C \uC804\uC7C1\uC758 \uCC38\uD654\uB97C \uD53C\uD574\uAC00\uC9C4
      \uBABB\uD588\uB358 \uAC83\uC774\uB2E4."
  - description: "\uC0B4\uC778\uACFC \uD30C\uAD34\uAC00 \uC77C\uC0C1\uC778 \uC804\uC120
      \uD55C\uBCF5\uD310\uC5D0\uC11C\uB3C4 \uB54C\uB85C\uB294 \uAE30\uAD34\uD560
      \uC815\uB3C4\uB85C \uBC1D\uC544\uBCF4\uC774\uC9C0\uB9CC, \uC774\uAC83\uC740
      \uADF8\uB140\uC758 \uC815\uC2E0\uC744 \uBC29\uC5B4\uD558\uAE30 \uC704\uD55C
      \uBC29\uC5B4\uAE30\uC81C\uC5D0 \uAC00\uAE5D\uB2E4.\n\n\uC778\uC0DD\uC5D0 \uB9CE\uC740
      \uAD74\uACE1\uC810\uC774 \uC788\uC5C8\uB358 \uB2E4\uB978 \uC624\uD37C\uB808\uC774\uD130\uB4E4\uACFC
      \uB2EC\uB9AC \uC21C\uC218\uD55C \uBBFC\uAC04\uC778\uC5D0 \uAC00\uAE5D\uAE30\uC5D0
      \uBCC4 \uC218 \uC5C6\uB294 \uAC83.\n\n\uADF8\uB798\uC11C\uC778\uC9C0, \uADF8
      \uC18C\uC911\uD588\uB358 '\uC5B4\uC81C'\uC758 \uC774\uC57C\uAE30\uB97C \uAC00\uC838\uB2E4\uC904\uC9C0\uB3C4
      \uBAA8\uB974\uB294 \uAC10\uB3C5\uAD00\uC5D0\uAC8C \uAC10\uC815\uC744 \uBCF4\uC774\uB294
      \uAC83\uC740, \uC5B4\uB5BB\uAC8C \uBCF4\uBA74 \uC0C1\uB2F9\uD788 \uBED4\uD55C
      \uC774\uC57C\uAE30\uB2E4."
  - description: "\uCCB4\uCEE4 \uD50C\uB798\uADF8\uAC00 \uB0B4\uB824\uC640\uB3C4
      \uC6B0\uB9AC\uC758 \uB808\uC774\uC2A4\uB294 \uC808\uB300 \uB05D\uB098\uC9C0
      \uC54A\uC544.\r\n\uB0B4 \uC11C\uD0B7\uC758 \uD53C\uD2B8\uB808\uC778\uC5D0\uB294
      \uC5B8\uC81C\uB098 \uB124\uAC00 \uC788\uACE0, \uB0B4 \uC870\uC218\uC11D\uC740
      \uC601\uC6D0\uD788 \uB108\uB9CC\uC758 \uC9C0\uC815\uC11D\uC774\uC57C.\n\n.....\uC800\uAE30,
      \uAC10\uB3C5\uAD00.\n\uC544\uCE78\uC18C... \uC9C0\uAE08\uC740 \uC880 \uB098\uC058\uB2E4\uC9C0\uB9CC,
      \uACF5\uAE30\uB3C4 \uC88B\uACE0, \uC0AC\uB78C\uB4E4\uB3C4... \uAD1C\uCC2E\uACE0.\n\n...\n\n\uBAA8\uB4E0
      \uC77C\uC774 \uB05D\uB098\uBA74... \uC544\uCE78\uC18C\uB85C, \uAC19\uC774 \uAC14\uC73C\uBA74
      \uD558\uB294\uB370.\n\n\uB9C8\uD14C\uB9AC\uC5BC\uC5D0 \uC65C \uB0B4 \uC774\uC57C\uAE30\uAC00
      \uC801\uD600 \uC788\uB0D0\uACE0? \uD6C4\uD6C4, \uADF8\uC57C \uD574\uD0B9\uD55C\uAC8C
      \uB2F9\uC5F0\uD558\uC796\uC544!"
