  shopUpperBodyPortraitDimmed: {fileID: 3748452310637042673, guid: 489e9269d72c4a84b8e8d6ee5d1bd8ed, type: 3}
  alternateName: Bartender
  shopDialogue: "\uC6B0\uB9AC\uB294 \uBE5B\uC774 \uC5C6\uB294 \uACF3\uC5D0\uC11C\n\uB2E4\uC2DC
    \uB9CC\uB0A0 \uAC70\uC57C."
  codename: Bartender
  role: "R&C  \uD2B9\uC791\uC870"
  faction: "R&C \uCEF4\uD37C\uB2C8, ???"
  height: 172cm
  birthday: "5\uC6D4 14\uC77C"
  speciality: "\uC7A0\uC785, \uCE75\uD14C\uC77C"
  weapon: "\uBCA0\uB808\uD0C0 M74"
  origin: "\uC77C\uB4DC\uD504\uB791\uC2A4, \uD504\uB791\uC2A4\uAD6D"
  bondRecords:
  - description: "\uC774\uB984 : \uCE7C\uB9AC\uC2A4\uD14C \uBCF4\uB4DC\uB9AC\uC57C\uB974\n\uC2E0\uC7A5/\uCCB4\uC911
      : 172cm / 56kg\n\uD65C\uB3D9 \uC9C0\uC5ED:  \uC544\uB80C\uD6C4\uC820(\uC624\uB974\uD6C4\uC2A4),
      \uC720\uD2C0\uB780\uD2B8 \uBCF4\uD638\uB839\n\uC18D\uC131: \uC9C8\uC11C \uC545\n\n\"\uC6B0\uB9AC\uB294,
      \uBE5B\uC774 \uC5C6\uB294 \uACF3\uC5D0\uC11C \uB2E4\uC2DC \uB9CC\uB0A0 \uAC70\uC57C.\""
  - description: "R & C \uCEF4\uD37C\uB2C8\uC758 \uC624\uD37C\uB808\uC774\uD130 \uACB8...
      \uBC14\uD150\uB354. \uC77C\uB2E8\uC740.\n\n\uADF8 \uD2B9\uC720\uC758 \uC694\uC5FC\uD55C
      \uBBF8\uBAA8\uC640 \uADF9\uC5D0 \uB2EC\uD55C \uC740\uC2E0 \uBC0F \uCE68\uD22C
      \uB2A5\uB825\uC73C\uB85C \uCC2C\uC0AC\uBC1B\uB294 \uC694\uC6D0\uC774\uAE30\uB3C4
      \uD558\uB2E4.\n\uADF8\uB140\uB97C \uB4A4\uCAD2\uACE0 \uC788\uB294 \uC544\uD504\uBCA0\uC5B4\uB3C4
      \uC544\uC9C1\uAE4C\uC9C0 \uADF8\uB140\uC758 \uC2E0\uC0C1\uC740 \uD30C\uC545\uD558\uC9C0
      \uBABB\uD588\uC744 \uC815\uB3C4.\n\n\uC624\uD37C\uB808\uC774\uD130 \uB2A5\uB825\uB3C4
      \uADF9\uC5D0 \uB2EC\uD588\uC73C\uBA70, \uB3D9\uC544\uD504\uB9AC\uCE74 \uC6A9\uBCD1\uC804\uC7C1
      \uB2F9\uC2DC \uB0A8\uC544\uD504\uB9AC\uCE74 \uAD6D\uAC00\uD310\uBB34\uAD00\uBD80\uAC00
      \uBD88\uB7EC\uB4E4\uC778 \uBC31\uC1A1\uADF8\uB8F9 \uAE30\uB3D9\uD2B9\uBB34\uBD80\uB300\uB3C4
      \uACA9\uD1F4\uD588\uB2E4.\n\n...\uBB38\uC81C\uB77C\uACE0 \uD560\uBC95\uD55C
      \uAC83\uC740, R&C \uCEF4\uD37C\uB2C8 \uB0B4\uC5D0\uC11C\uB3C4 \uADF8\uB140\uC758
      \uC2E0\uC0C1\uC740 \uC54C\uB824\uC9C4 \uAC83\uC774 \uC5C6\uB2E4\uB294 \uAC83.
      \uCC3D\uC5C5\uC790\uC778 \uB808\uBCA0\uCE74\uB3C4 \uADF8\uB140\uC758 \uC2E0\uC0C1\uC744
      \uC81C\uB300\uB85C \uD30C\uC545\uD558\uC9C0 \uBABB\uD588\uB2E4\uB294 \uC18C\uBB38\uC774
      \uD30C\uB2E4\uD558\uB2E4."
  - description: "\uC131\uACA9\uC740 \uB300\uB2E8\uD788 \uCF8C\uB77D\uC8FC\uC758\uC801\uC774\uBA74\uC11C\uB3C4...
      \uC5FC\uC138\uC8FC\uC758\uC801\uC774\uB2E4.\n\uACBD\uACC4\uACF5\uBA85 \uB2A5\uB825\uC790
      \uBC1C\uD765 \uC870\uC9D0\uC744 \uBCF4\uC774\uAE30\uC5D0 \uC54C\uCF54\uC62C\uB3C4
      \uC798 \uD1B5\uD558\uC9C0 \uC54A\uC9C0\uB9CC, \uADF8\uB140\uAC00 \uC9C1\uC811
      \uC8FC\uC870\uD55C \uC220\uC744 \uB2EC\uACE0 \uC0AC\uB294 \uAC83\uC774\uB2E4.\n\n\uADF8\uB798\uC11C
      \uD56D\uC0C1 \uBCF4\uAE30\uC5D0 \uC8FC\uBCC0\uC5D0\uB3C4  \uC220\uC744 \uAD8C\uD558\uACE0,
      \uBCF8\uC778\uB3C4 \uB9CE\uC774 \uBA39\uB294 \uAC83\uCC98\uB7FC \uBCF4\uC774\uC9C0\uB9CC...
      \n\n\uC5B4\uCA4C\uB2E4 \uACA8\uC6B0 \uC220\uC5D0 \uCDE8\uD55C \uD6C4\uC5D0
      \uAE68\uC5B4\uB0AC\uC744 \uB54C\uC758 \uD5C8\uBB34\uAC10\uC5D0 \uBAB8\uBD80\uB9BC\uCE58\uBA74\uC11C\uB3C4... 
      \uADF8\uB140\uAC00 \uC138\uC0C1\uC5D0 \uB450\uACE0 \uC628,  \uC2DC\uAC04\uC774
      \uBA48\uCD94\uC5B4 \uBC84\uB9B0 \uADF8\uB140\uC758 \uC18C\uC911\uD55C \uC0AC\uB78C\uB4E4\uC744
      \uC7A0\uC2DC\uB098\uB9C8 \uC78A\uACE0 \uC2F6\uAE30\uC5D0."
  - description: "\uC815\uCCB4\uB294, \uB2E4\uB984\uC544\uB2CC \uC61B \uC790\uC720
      \uD504\uB791\uC2A4\uC758 \uB9C8\uC9C0\uB9C9 \uD6C4\uACC4 \uC870\uC9C1\uC778
      \uC5D0\uD22C\uC54C \uB9AC\uBE0C\uB808\uC758 \uCCA9\uBCF4 \uC694\uC6D0...\uC774\uB77C\uACE0
      \uC54C\uB824\uC838 \uC788\uB2E4.\n\n\uB2E4\uB9CC, \uBCF8\uC778 \uC790\uCCB4\uAC00
      \uBBFC\uC8FC\uC8FC\uC758\uC640 \uD504\uB791\uC2A4 \uACF5\uD654\uAD6D\uC758
      \uADC0\uD658\uC5D0\uB294 \uB531\uD788 \uAD00\uC2EC\uC774 \uC5C6\uC5B4\uBCF4\uC774\uBBC0\uB85C
      \uADF8\uAC83 \uB610\uD55C \uC5F0\uB9C9\uC774 \uC544\uB2CC\uAC00? \uD558\uB294
      \uC2DC\uAC01\uB3C4 \uC788\uB2E4.\n\n\uADF8\uB140\uC5D0\uAC8C \uC81C\uC77C \uC911\uC694\uD55C
      \uAC00\uCE58\uB294 \uC99D\uC624\uC640 \uC0AC\uB791\uC774\uBBC0\uB85C.\n\n\uACB0\uAD6D,
      \uADF8\uB140\uC758 \uC2E0\uC6D0\uC740 \uC544\uD504\uBCA0\uC5B4\uB3C4, R&C \uCEF4\uD37C\uB2C8
      \uC218\uB1CC\uBD80\uB3C4, \uAC10\uB3C5\uAD00\uC774 \uC54C \uAE38\uC774 \uC5C6\uB294
      \uAC83\uC774\uB2E4.\n\n\uCE7C\uB9AC\uC2A4\uD14C, \uB77C\uB294 \uC774\uB984\uB3C4
      \uC704\uC7A5\uC2E0\uBD84\uC774\uB77C\uB294 \uC18C\uBB38\uC774 \uC788\uC744
      \uB9CC\uD07C."
  - description: "\uBCFC \uB9CC\uD07C \uBD24\uC796\uC544, \uADF8\uB807\uC9C0?\n.....\uC54C
      \uAC83 \uC5C6\uC796\uC544. \uC774 \uC774\uC0C1.\n\n\uC5EC\uAE30 \uC788\uB358
      \uB0B4\uC6A9\uC740, \uB0B4\uAC00 \uC804\uBD80 \uC9C0\uC6CC\uBC84\uB838\uB294\uAC78?\n\uBB50,
      \uB0B4 \uACC1\uC5D0 \uC788\uC73C\uBA74 \uCC28\uBD84\uD558\uAC8C \uC54C\uB824\uC904
      \uD14C\uB2C8\uAE4C.\n\n\uC544\uC544--\uC815\uB9D0\uC774\uC9C0. \uC0DD\uD53C\uC5D0\uB974\uC758
      \uB178\uCE5C\uB124\uB4E4\uC740 \uC774\uC81C \uC0C1\uAD00\uC5C6\uC5B4.\n........\uB3C4\uB9DD\uAC00\uBA74,
      \uC54C\uC9C0?"
