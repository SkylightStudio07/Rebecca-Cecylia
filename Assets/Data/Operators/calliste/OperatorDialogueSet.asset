  m_Name: OperatorDialogueSet
  m_EditorClassIdentifier: Assembly-CSharp::RCCom.UI.OperatorDialogueSet
  lobbyIdleSprite: {fileID: 6660641790689550690, guid: 5b6d79512458acf4d95c461e680addc4, type: 3}
  idleSprite: {fileID: 8573740378125166142, guid: 93979212c860bc740a289e3b210e4fdf, type: 3}
  lobbyInteraction:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 0}
    defaultLobbySprite: {fileID: 6660641790689550690, guid: 5b6d79512458acf4d95c461e680addc4, type: 3}
    entries:
    - text: "\uC220\uC744 \uC11E\uACE0, \uC778\uC0DD\uC744 \uBC14\uAFD4 \uC904 \uC2DC\uAC04\uC774\uC57C.\n\uAC10\uB3C5\uAD00\uB3C4
        \uD55C \uC794 \uC5B4\uB5A8\uAE4C?"
      lobbySprite: {fileID: 6660641790689550690, guid: 5b6d79512458acf4d95c461e680addc4, type: 3}
      portraitSprite: {fileID: 0}
    - text: "\uD55C \uC794\uC758 \uCE75\uD14C\uC77C\uC740, \uC0B6\uC744 \uBC14\uAFB8\uAE30\uC5D0
        \uCDA9\uBD84\uD558\uB2C8\uAE4C. \uADF8\uB807\uC9C0?"
      lobbySprite: {fileID: 4210111981508132220, guid: b5c9e5e637527324faef1cf8a5acaae1, type: 3}
      portraitSprite: {fileID: 0}
    lines: []
  lobbyReturnTogether:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 0}
    defaultLobbySprite: {fileID: 6660641790689550690, guid: 5b6d79512458acf4d95c461e680addc4, type: 3}
    entries:
    - text: "\uAC19\uC774 \uC5F4\uC2EC\uD788 \uD588\uB124, \uAC10\uB3C5\uAD00.\n\uC88B\uC544,
        \uBCF8\uC5C5\uC73C\uB85C \uB3CC\uC544\uAC00 \uBCFC\uAE4C."
      lobbySprite: {fileID: 6660641790689550690, guid: 5b6d79512458acf4d95c461e680addc4, type: 3}
      portraitSprite: {fileID: 0}
    lines: []
  lobbyReturn:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 0}
    defaultLobbySprite: {fileID: -2757826682725406847, guid: 80e0e080d931dcd49b84f7f4e0cb4f74, type: 3}
    entries:
    - text: "\uC790\uC544\uC790\uC544, \uC5F4\uC2EC\uD788 \uD558\uACE0 \uC628 \uAC70\uC57C?
        \uD6C4\uD6C4.\n\uC218\uACE0\uD588\uC5B4. \uBAA8\uD788\uB610 \uD55C \uC794
        \uD560\uB798?"
      lobbySprite: {fileID: -2757826682725406847, guid: 80e0e080d931dcd49b84f7f4e0cb4f74, type: 3}
      portraitSprite: {fileID: 0}
    lines: []
  lobbyTouchUnfamiliar:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 0}
    defaultLobbySprite: {fileID: 6660641790689550690, guid: 5b6d79512458acf4d95c461e680addc4, type: 3}
    entries:
    - text: "\uC220\uC744 \uC11E\uACE0, \uC778\uC0DD\uC744 \uBC14\uAFD4 \uC904 \uC2DC\uAC04\uC774\uC57C.\n\uAC10\uB3C5\uAD00\uB3C4
        \uD55C \uC794 \uC5B4\uB5A8\uAE4C?"
      lobbySprite: {fileID: 6660641790689550690, guid: 5b6d79512458acf4d95c461e680addc4, type: 3}
      portraitSprite: {fileID: 0}
    - text: "\uD55C \uC794\uC758 \uCE75\uD14C\uC77C\uC740, \uC0B6\uC744 \uBC14\uAFB8\uAE30\uC5D0
        \uCDA9\uBD84\uD558\uB2C8\uAE4C. \uADF8\uB807\uC9C0?"
      lobbySprite: {fileID: 7609906967425873338, guid: 9fa41abfa3c01f74ea356e88c98ac608, type: 3}
      portraitSprite: {fileID: 0}
    lines: []
  lobbyTouchFavorable:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 0}
    defaultLobbySprite: {fileID: -2757826682725406847, guid: 80e0e080d931dcd49b84f7f4e0cb4f74, type: 3}
    entries:
    - text: "\uC790, \uAC10\uB3C5\uAD00\uB3C4 \uBA4D \uADF8\uB9CC \uB54C\uB9AC\uACE0
        \uC77C\uD574\uC57C\uC9C0? \uD6C4\uD6C4.\n\uC77C \uB3C4\uC911\uC5D0 \uD5C8\uB77D\uB418\uB294
        \uAC74 \uCEE4\uD53C\uB791 \uBB3C \uBFD0\uC774\uB2C8\uAE4C."
      lobbySprite: {fileID: -2757826682725406847, guid: 80e0e080d931dcd49b84f7f4e0cb4f74, type: 3}
      portraitSprite: {fileID: 0}
    - text: "\uAC8C\uB974\uB9C8\uB2C8\uC544\uC758 \uD3ED\uAD70\uB4E4\uC774 \uB0B4
        \uBAA8\uB4E0 \uAC83\uC744 \uC557\uC544\uAC14\uC9C0\uB9CC... \n\uADF8\uB7FC\uC5D0\uB3C4
        \uB098\uB294 \uBC14\uD150\uB354\uC57C. \uBB50, \uAC00\uB054\uC740 \uC624\uD37C\uB808\uC774\uD130."
      lobbySprite: {fileID: 4210111981508132220, guid: b5c9e5e637527324faef1cf8a5acaae1, type: 3}
      portraitSprite: {fileID: 0}
    - text: "\uCC9C\uCC9C\uD788 \uD574. \uC220\uC774 \uB3C4\uB9DD\uAC00\uC9C0\uB294
        \uC54A\uC73C\uB2C8\uAE4C.\n\uB2F9\uC2E0\uACFC\uB294 \uC88B\uC740 \uC220\uCE5C\uAD6C\uAC00
        \uB420 \uC218 \uC788\uC744 \uAC83 \uAC19\uC544\uC11C \uB9D0\uC774\uC57C."
      lobbySprite: {fileID: 7880295389704059690, guid: cdf4713855344024ba041d066aa19d13, type: 3}
      portraitSprite: {fileID: 0}
    lines: []
  lobbyTouchJoy:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 0}
    defaultLobbySprite: {fileID: -4085230981605078119, guid: c45112f2b11d98141b67c0bf02bb7de7, type: 3}
    entries:
    - text: "\uC624? \uAC10\uB3C5\uAD00 \uAD70. \uC7A0\uAE50 \uB098\uB791 \uC774\uC57C\uAE30
        \uC880 \uD560\uAE4C.\n\uB9C8\uCE68 \uC798 \uB410\uB124. \uC77C\uD558\uAE30
        \uC2EB\uC740 \uCC38\uC774\uC5C8\uAC70\uB4E0.\n\uAC70\uBD80\uAD8C\uC740 \uC5C6\uC5B4.
        \uB0B4\uAC00 \uADF8\uB9AC \uC815\uD588\uC73C\uB2C8\uAE4C."
      lobbySprite: {fileID: -4085230981605078119, guid: c45112f2b11d98141b67c0bf02bb7de7, type: 3}
      portraitSprite: {fileID: 0}
    - text: "\uB108\uBB34 \uBB34\uB9AC\uD558\uC9C4 \uB9C8. \uB098\uC758 \uAC10\uB3C5\uAD00.\n...\uC2F8\uC6C0\uACFC
        \uC8FD\uC74C\uC5D0\uB294 \uC22D\uACE0\uD568\uAC19\uC740 \uAC74 \uC5C6\uC73C\uB2C8\uAE4C.\n\uC2A4\uC2A4\uB85C\uC5D0\uAC8C
        \uCDA9\uC2E4\uD558\uAC8C \uC0B4\uC544\uAC00\uBA74 \uB418\uB294 \uAC70\uC57C,
        \uADF8\uB807\uC9C0?"
      lobbySprite: {fileID: -5881590094955841770, guid: 81a372421d175ff45b8f3754c759c181, type: 3}
      portraitSprite: {fileID: 0}
    - text: "......\uC774\uC0C1\uD558\uB124, \uC65C \uAC10\uB3C5\uAD00 \uACC1\uC5D0
        \uC788\uC73C\uBA74 \uAC00\uC2B4\uC774 \uB6F0\uB294 \uAC78\uAE4C."
      lobbySprite: {fileID: 8814610960599790580, guid: 28a4746e94cc4274cba83ae73b97a6cf, type: 3}
      portraitSprite: {fileID: 0}
    lines: []
  lobbyTouchLove:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 0}
    defaultLobbySprite: {fileID: -7506882270989189481, guid: 684277abd43e95347a35e8c22904bbd2, type: 3}
    entries:
    - text: "...\uADF8\uB807\uAC8C\uB098 \uC815\uC5F4\uC801\uC73C\uB85C \uB300\uD654\uD558\uB358\uB370,
        \uC800\uB7F0 \uCABD\uC774 \uCDE8\uD5A5\uC778 \uAC70\uC57C?\n\uC774\uB7EC\uBA74
        \uC7AC\uBBF8\uC5C6\uC5B4, \uAC10\uB3C5\uAD00."
      lobbySprite: {fileID: -7506882270989189481, guid: 684277abd43e95347a35e8c22904bbd2, type: 3}
      portraitSprite: {fileID: 0}
    - text: "\uC544\uC544- \uC815\uB9D0. \uC774\uB7F0 \uAE30\uBD84\uC744 \uB290\uB07C\uAC8C
        \uB420 \uC904\uC740 \uBAB0\uB790\uB294\uB370. \n\uB208 \uD53C\uD558\uC9C0
        \uB9C8. \uCC45\uC784\uC744 \uC9C0\uB780 \uB9D0\uC774\uC57C."
      lobbySprite: {fileID: 4465813358472088543, guid: 52bc22b69ec604e4fb919e1b67286f9c, type: 3}
      portraitSprite: {fileID: 0}
    - text: "\uB09C \uC9C0\uAE08\uAE4C\uC9C0 \uC0AC\uACE0 \uC2F6\uC5C8\uB358 \uC220\uC744
        \uB193\uCCD0\uBCF8 \uC801\uC774 \uC5C6\uC5B4.\n\uADF8\uB7EC\uB2C8\uAE4C...
        \uAC01\uC624\uD558\uC138\uC694? \uAC10\uB3C5\uAD00 \uAD70."
      lobbySprite: {fileID: -2757826682725406847, guid: 80e0e080d931dcd49b84f7f4e0cb4f74, type: 3}
      portraitSprite: {fileID: 0}
    lines: []
  lobbyTouchEx:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 0}
    defaultLobbySprite: {fileID: -1235759629914864974, guid: 994ab720d7221184e992c07a3d089687, type: 3}
    entries:
    - text: "...\n\uB098\uB9CC \uBC14\uB77C\uBD10."
      lobbySprite: {fileID: -1235759629914864974, guid: 994ab720d7221184e992c07a3d089687, type: 3}
      portraitSprite: {fileID: 0}
    - text: "\uC774\uB7F0 \uC5EC\uC790\uC778\uC9C0 \uBAB0\uB790\uC9C0?\n\uADF8\uB0E5,
        \uC798\uBABB \uAC78\uB838\uB2E4\uACE0 \uC0DD\uAC01\uD574."
      lobbySprite: {fileID: 635651229585826107, guid: cf13b6e2cd9cf504f9d00610089f369c, type: 3}
      portraitSprite: {fileID: 0}
    - text: "\uC544\uC544-- \uAC10\uB3C5\uAD00 \uAD70\uC744 \uD68C\uC0AC\uC5D0\uC11C
        \uBE7C\uB124\uC11C \uC5B4\uB518\uAC00\uB85C \uB3C4\uB9DD\uCCD0\uBC84\uB9AC\uACE0
        \uC2F6\uB124.\n\uC800\uAE30, \uC0DD\uAC01 \uC788\uC5B4? \uB300\uAC00\uB85C
        \uB0B4 \uBAA8\uB4E0 \uAC83\uC744 \uC904\uAC8C."
      lobbySprite: {fileID: -5881590094955841770, guid: 81a372421d175ff45b8f3754c759c181, type: 3}
      portraitSprite: {fileID: 0}
    - text: "\uBD84\uBA85\uD788 \uACBD\uACE0\uD588\uC5B4.\n\uB0B4 \uB208 \uC55E\uC5D0\uC11C
        \uB2E4\uB978 \uC0AC\uB78C\uC5D0\uAC8C \uB208\uAE38 \uC8FC\uC9C0 \uB9C8."
      lobbySprite: {fileID: 371691081268867814, guid: f0dce18c912b0414d970b695df6e4cb5, type: 3}
      portraitSprite: {fileID: 0}
    - text: "......\u2665"
      lobbySprite: {fileID: -768436415341960148, guid: c0b571280df1d61489112244177e6a28, type: 3}
      portraitSprite: {fileID: 0}
    lines: []
  gameStart:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 8573740378125166142, guid: 93979212c860bc740a289e3b210e4fdf, type: 3}
    defaultLobbySprite: {fileID: 0}
    entries:
    - text: "\uC790\uC790- \uC2DC\uC791\uD574 \uBCFC\uAE4C.\n\uCE75\uD14C\uC77C\uC740
        \uB610 \uD558\uB098\uC758 \uC77C\uC0DD. \uC11E\uC5B4\uBCF4\uC790\uACE0."
      lobbySprite: {fileID: 0}
      portraitSprite: {fileID: 0}
    lines: []
  skillUsed:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 5696914043844203004, guid: 4d0fe274698f0ad4787a3be2c67b685f, type: 3}
    defaultLobbySprite: {fileID: 0}
    entries:
    - text: "\uC88B\uC544. \uBCA4\uC790\uBBFC\uAE09 \uC5D4\uC9C4 \uC624\uBC84\uB4DC\uB77C\uC774\uBE0C
        \uD655\uC778.\n\uAC10\uB3C5\uAD00\uC758 \uAE30\uCCB4\uAC00 \uD760\uBED1 \uCDE8\uD574\uBC84\uB838\uB2E4\uACE0."
      lobbySprite: {fileID: 0}
      portraitSprite: {fileID: 0}
    lines: []
  baseAttacked:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 1922646719277431222, guid: e2675fa508fe9eb4e9e93b87c43e6d95, type: 3}
    defaultLobbySprite: {fileID: 0}
    entries:
    - text: "\uC800\uAE30 \uB9D0\uC774\uC9C0~ \uAC70\uC810, \uC880 \uBD10\uC918\uC57C
        \uD560 \uAC83 \uAC19\uC740\uB370.\n\uB09C \uB0B4 \uBC14\uC5D0 \uC774\uC0C1\uD55C
        \uC190\uB2D8 \uC624\uB294 \uAC70 \uC2EB\uAC70\uB4E0?"
      lobbySprite: {fileID: 0}
      portraitSprite: {fileID: 0}
    lines: []
  playerHit:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 1922646719277431222, guid: e2675fa508fe9eb4e9e93b87c43e6d95, type: 3}
    defaultLobbySprite: {fileID: 0}
    entries:
    - text: "\uAE30\uCCB4 \uD53C\uACA9 \uD655\uC778. \uCE75\uD14C\uC77C \uC794\uC774
        \uAE68\uC838\uAC00\uACE0 \uC788\uC5B4.\n\uACB0\uAD6D \uC81C\uC77C \uC911\uC694\uD55C
        \uAC74 \uBAA9\uC228\uC774\uC57C, \uC8FC\uC758\uD574. \uAC10\uB3C5\uAD00."
      lobbySprite: {fileID: 0}
      portraitSprite: {fileID: 0}
    lines: []
  playerHitCritical:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: -4782886341211926166, guid: 97077c3b7523a1847b565bf8bdff5874, type: 3}
    defaultLobbySprite: {fileID: 0}
    entries:
    - text: "\uB180\uC774\uB294 \uAC70\uAE30\uAE4C\uC9C0. \uAC70\uAE30\uC11C \uBE60\uC838\uB098\uC640,
        \uC9C0\uAE08 \uB2F9\uC7A5.\n\uAE30\uCCB4 \uB370\uBBF8\uC9C0 \uCEE8\uD2B8\uB864
        \uAC1C\uC2DC. "
      lobbySprite: {fileID: 0}
      portraitSprite: {fileID: 0}
    lines: []
  insufficientGold:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: -6434981272782448936, guid: ac9284947af426a4f917efd6c7f6b27d, type: 3}
    defaultLobbySprite: {fileID: 0}
    entries:
    - text: "\uC5EC\uAE34 \uD558\uBC14\uB86D\uC2A4\uD06C\uAC00 \uC544\uB2C8\uC57C?
        \uBB58 \uC0AC\uB824\uBA74, \uADF8\uB9CC\uD07C\uC758 \uB3C8\uC740 \uC788\uC5B4\uC57C
        \uD574.\n\uCC38\uACE0\uB85C, \uB0B4 \uBC14\uB294 \uC678\uC0C1 \uAC19\uC740
        \uAC70 \uC5C6\uC5B4?"
      lobbySprite: {fileID: 0}
      portraitSprite: {fileID: 0}
    lines: []
  slotUnavailable:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 2455077197487711693, guid: 732cfed1f66fd5b4d9ac0088e1cc336b, type: 3}
    defaultLobbySprite: {fileID: 0}
    entries:
    - text: "\uC2AC\uB86F\uC774 \uBD80\uC871\uD574. \uB2E4\uC74C \uC5C5\uADF8\uB808\uC774\uB4DC
        \uD328\uC2A4\uB97C \uB178\uB824\uBD10."
      lobbySprite: {fileID: 0}
      portraitSprite: {fileID: 0}
    lines: []
  playerDied:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: -4782886341211926166, guid: 97077c3b7523a1847b565bf8bdff5874, type: 3}
    defaultLobbySprite: {fileID: 0}
    entries:
    - text: "\uC8FD\uAC8C \uB450\uC9C0 \uC54A\uC544. \uC870\uAE08\uB9CC \uAE30\uB2E4\uB824."
      lobbySprite: {fileID: 0}
      portraitSprite: {fileID: 0}
    lines: []
  baseDestroyed:
    defaultPortraitSprite: {fileID: 0}
    portraitSprite: {fileID: 2455077197487711693, guid: 732cfed1f66fd5b4d9ac0088e1cc336b, type: 3}
    defaultLobbySprite: {fileID: 0}
    entries:
    - text: "...\uCD1D\uCCB4\uC801 \uC784\uBB34 \uC2E4\uD328.\n\uADF8\uB798\uB3C4
        \uB2F9\uC2E0\uC774 \uBB34\uC0AC\uD574\uC11C \uB2E4\uD589\uC774\uC57C. \uC790,
        \uC220\uC774\uB098 \uD55C \uC794 \uD558\uC790\uAD6C."
      lobbySprite: {fileID: 0}
      portraitSprite: {fileID: 0}
    lines: []
