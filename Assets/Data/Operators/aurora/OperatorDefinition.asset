  m_Name: OperatorDefinition
  m_EditorClassIdentifier: Assembly-CSharp::RCCom.Definitions.Operator.OperatorDefinition
  operatorId: aurora
  displayName: "\uC624\uB85C\uB77C"
  playStyleDescription: "\uC804\uC790\uC804\uACFC \uB514\uBC84\uD504 \uB4DC\uB860\uC73C\uB85C
    \uC801\uC758 \uBC29\uC5B4\uC120\uC744 \uBB34\uB825\uD654\uD558\uB294 \uCC9C\uC7AC
    \uD574\uCEE4"
  selectionPortrait: {fileID: 5289064701412196668, guid: bb1abba075bbd6d4ead988923493eb6d, type: 3}
  managementPortrait: {fileID: 3339152671587006292, guid: f1835f90c9e5d27469c36ff53f78fe2d, type: 3}
  shopPortrait: {fileID: 3339152671587006292, guid: f1835f90c9e5d27469c36ff53f78fe2d, type: 3}
  shopUpperBodyPortrait: {fileID: -2565678213714093970, guid: b3025d6bfe0364940869a9a91bc27071, type: 3}
  shopUpperBodyPortraitDimmed: {fileID: 5426730094900957068, guid: 78e34ada9ec1051478b5564069bf747a, type: 3}
  alternateName: Hacker
  shopDialogue: "\uC138\uC0C1\uC740 \uD558\uB098\uC758 \uAC8C\uC784\uC774\uC57C.\n\uD50C\uB808\uC774\uB294,
    \uC6B0\uB9AC\uC758 \uBAAB\uC778 \uAC70\uACE0."
  codename: Hacker
  role: "R&C \uC804\uC790\uC804 \uD2B9\uC791\uC870"
  faction: "R&C \uCEF4\uD37C\uB2C8, FWTO(\uC790\uC720\uC138\uACC4\uC870\uC57D\uAE30\uAD6C)"
  height: 160cm
  birthday: "8\uC6D4 18\uC77C"
  speciality: "\uC804\uC790\uC804 \uCE68\uD22C, \uB4DC\uB860 \uC6D0\uACA9 \uD574\uD0B9"
  weapon: "\uC2A4\uB9C8\uD2B8 PDW, \uCEE4\uC2A4\uD140 \uC804\uC790\uC804 \uD3EC\uD2B8"
  origin: "\uD1A0\uB860\uD1A0, \uCE90\uB098\uB2E4 \uC5F0\uBC29 (FWTO)"
  bondRecords:
  - description: "\uC774\uB984 : \uC624\uB85C\uB77C (\uBCF8\uBA85 \uBD88\uC0C1)\n\uC2E0\uC7A5/\uCCB4\uC911
      : 160cm / 47kg\n\uD65C\uB3D9 \uC9C0\uC5ED : \uD1A0\uB860\uD1A0(FWTO), R&C \uCEF4\uD37C\uB2C8
      \uC804\uC120 \uB124\uD2B8\uC6CC\uD06C\n\uC18D\uC131 : \uD63C\uB3C8 \uC120\n\n\"\uC138\uC0C1\uC740
      \uD558\uB098\uC758 \uAC70\uB300\uD55C \uAC8C\uC784\uC774\uC57C.\n\uD50C\uB808\uC774\uB294,
      \uC6B0\uB9AC\uC758 \uBAAB\uC778 \uAC70\uACE0.\""
  - description: "R&C \uCEF4\uD37C\uB2C8\uC758 \uC678\uC8FC \uC624\uD37C\uB808\uC774\uD130
      \uACB8 \uCD08\uC77C\uB958 \uB137\uB7EC\uB108.\n\n\uC804\uC7A5\uBCF4\uC548\uAE30\uC220\uAD6D\uACFC
      \uC544\uD504\uBCA0\uC5B4\uC758 \uBCF4\uC548 \uBC29\uD654\uBCBD\uC870\uCC28
      \uC7A5\uB09C\uAC10 \uB2E4\uB8E8\uB4EF \uB6AB\uC5B4\uBC84\uB9AC\uB294 \uC2E4\uB825\uC790\uB85C,
      \uC790\uCE6D '\uCE90\uB098\uB2E4 \uCD5C\uACE0\uC758 \uD574\uCEE4'.\n\n\uC804\uC7A5\uC5D0\uC11C\uB294
      \uB2E4\uC218\uC758 \uC790\uC728\uD615 \uB514\uBC84\uD504\xB7\uAC10\uC18D \uB4DC\uB860\uC744
      \uB2E8\uB9D0\uAE30 \uD558\uB098\uB85C \uC624\uBC84\uD074\uB7ED \uC81C\uC5B4\uD558\uC5EC
      \uC801\uC758 \uD1B5\uC2E0\uACFC \uAE30\uACC4\uD654 \uC7A5\uBE44\uB97C \uC21C\uC2DD\uAC04\uC5D0
      \uB9C8\uBE44\uC2DC\uD0A8\uB2E4.\n\uCC3D\uC5C5\uC790\uC778 \uB808\uBCA0\uCE74\uAC00
      \uAC70\uC561\uC758 \uC678\uC8FC\uBE44\uC640 \uCD5C\uACE0\uAE09 \uC11C\uBC84
      \uC790\uC6D0\uC744 \uC57D\uC18D\uD558\uACE0 \uC601\uC785\uD588\uC73C\uB098,
      \uC815\uC791 \uBCF8\uC778\uC740 \uB3C8\uBCF4\uB2E4 '\uC7AC\uBBF8\uC788\uB294
      \uD310(Game)'\uC744 \uCC3E\uC544 \uC990\uAC81\uAC8C \uC804\uC7A5\uC744 \uD718\uC813\uACE0
      \uB2E4\uB2CC\uB2E4."
  - description: "\uC131\uACA9\uC740 \uB2F9\uB3CC\uD558\uACE0 \uC7A5\uB09C\uAE30
      \uB118\uCE58\uBA70 \uB9E4\uC0AC\uC5D0 \uC790\uC2E0\uB9CC\uB9CC\uD558\uC9C0\uB9CC...
      \uC2E4\uC0C1\uC740 \uACBD\uACC4\uACF5\uBA85 \uD604\uC0C1\uC73C\uB85C \uC778\uD574
      \uC804\uD30C \uC2E0\uD638\uC640 \uCF54\uB4DC\uB97C \uB1CC\uD30C\uB85C \uC9C1\uC811
      \uC2DC\uAC01\uD654\uD574 \uC778\uC9C0\uD558\uB294 \uD76C\uADC0\uD55C \uC804\uB1CC\uACC4
      \uACF5\uBA85 \uB2A5\uB825\uC790\uB2E4.\n\n\uC804 \uC138\uACC4\uC758 \uBB34\uC218\uD55C
      \uB178\uC774\uC988\uC640 \uB370\uC774\uD130 \uD328\uD0B7\uC774 24\uC2DC\uAC04
      \uB0B4\uB0B4 \uB1CC \uC18D\uC73C\uB85C \uBC00\uB824\uB4E4\uC5B4\uC624\uAE30\uC5D0
      \uD56D\uC0C1 \uB9CC\uC131\uC801\uC778 \uC2E0\uACBD \uACFC\uBD80\uD558\uB97C
      \uACAA\uACE0 \uC788\uB2E4.\n\uD2B9\uC720\uC758 \uD5E4\uB4DC\uC14B\uACFC \uC74C\uC545,
      \uADF8\uB9AC\uACE0 \uAC10\uB3C5\uAD00\uACFC\uC758 \uC7A1\uB2F4 \uBC0F \uAC8C\uC784\uC740
      \uADF8 \uACFC\uC5F4\uB41C \uB1CC\uB97C \uC2DD\uD600\uC8FC\uB294 \uC720\uC77C\uD55C
      \uC548\uC2DD\uCC98\uC778 \uC148\uC774\uB2E4."
  - description: "\uACFC\uAC70 \uC790\uC720\uC138\uACC4\uC870\uC57D\uAE30\uAD6C(FWTO)
      \uC0B0\uD558 \uC804\uC790\uC804 \uBD80\uB300 \uCD9C\uC2E0\uC774\uB77C\uB294
      \uC18C\uBB38\uC774 \uC788\uC73C\uB098, \uAC70\uB300\uAE30\uC5C5\uB4E4\uACFC
      \uAD70\uBC8C\uB4E4\uC758 \uBE44\uBC00 \uAE08\uACE0 \uBC0F \uB3C5\uC7AC \uC815\uAD8C\uC758
      \uAD70\uC0AC \uAE30\uBC00\uC744 \uD138\uC5B4 \uAC01\uC9C0\uC758 \uC800\uD56D\uAD70\uB4E4\uC5D0\uAC8C
      \uBB34\uC0C1 \uBC30\uD3EC\uD558\uB358 '\uB137\uB7EC\uB108 \uC758\uC801\uB2E8'\uC758
      \uD575\uC2EC \uB9AC\uB354\uC600\uB2E4.\n\n\uC5F4\uAC15\uB4E4\uC758 \uCD94\uC801\uC744
      \uD53C\uD574 \uBD81\uBBF8\uB97C \uB5A0\uB098 \uC720\uB791\uD558\uB358 \uC911
      R&C \uCEF4\uD37C\uB2C8\uC640 \uAC10\uB3C5\uAD00\uC744 \uB9CC\uB0AC\uACE0, \uCC98\uC74C\uC73C\uB85C
      '\uC5B8\uC81C\uB4E0 \uC811\uC18D\uC744 \uB04A\uACE0 \uB3C4\uB9DD\uCE60 \uD544\uC694\uAC00
      \uC5C6\uB294 \uC548\uC804\uD55C \uC11C\uBC84(\uC9D1)'\uB97C \uBC1C\uACAC\uD588\uB2E4\uACE0
      \uB290\uB080\uB2E4.\n\n\"\uB0B4 \uCCA0\uBCBD \uBCF4\uC548 \uC2DC\uC2A4\uD15C\uC5D0
      \uBC31\uB3C4\uC5B4 \uC2EC\uC740 \uBC94\uC778\uC774 \uB204\uAD70\uC9C0 \uC54C\uC544?
      ...\uAC10\uB3C5\uAD00 \uB108\uC796\uC544, \uBC14\uBCF4\uC57C.\""
  - description: "\uC774\uC81C... \uAC10\uB3C5\uAD00 \uC5C6\uC774\uB294 \uB0B4 \uC2DC\uC2A4\uD15C
      \uB85C\uADF8\uC778\uB3C4 \uC548 \uB418\uC796\uC544.\n\n\uB0B4 \uBAA8\uB4E0
      \uC554\uD638\uD0A4\uC640 \uC804\uB1CC \uB8E8\uD2B8 \uAD8C\uD55C, \uAC10\uB3C5\uAD00\uD55C\uD14C\uB9CC
      \uC601\uAD6C \uACF5\uC720\uD574\uB458 \uD14C\uB2C8\uAE4C... \uD3C9\uC0DD \uCC45\uC784\uC838,
      \uC54C\uC558\uC9C0?\n\n\uC774 \uC138\uC0C1\uC774 \uC544\uBB34\uB9AC \uC794\uD639\uD55C
      \uBC84\uD14D\uC2A4\uB098 \uC5F4\uAC15\uB4E4\uC758 \uCCB4\uC2A4\uD310\uC774\uB77C
      \uD574\uB3C4 \uC0C1\uAD00\uC5C6\uC5B4. \uB0B4 \uC778\uC0DD\uC758 \uB9C8\uC9C0\uB9C9
      \uC5D4\uB4DC\uAC8C\uC784 \uD50C\uB808\uC774\uC5B4\uB294 \uC624\uC9C1 \uB108
      \uD558\uB098\uBFD0\uC774\uB2C8\uAE4C.\n\n...\uC0AC\uB791\uD574, \uB098\uC758
      \uC601\uC6D0\uD55C \uAD00\uB9AC\uC790\uB2D8\u2665"
