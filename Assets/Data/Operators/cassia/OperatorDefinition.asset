  operatorId: cassia
  displayName: "\uCE74\uC2DC\uC544"
  playStyleDescription: "\uD0C0\uC6CC \uAC74\uC124\uACFC \uCE74\uB4DC \uAC15\uD654\uB97C
    \uC911\uC2EC\uC73C\uB85C \uBC29\uC5B4\uC120\uC744 \uD655\uC7A5\uD558\uB294 \uAE30\uBCF8
    \uC624\uD37C\uB808\uC774\uD130"
  selectionPortrait: {fileID: 8101380904372118242, guid: 7692c1b2ac922604a964bcd1026289c7, type: 3}
  managementPortrait: {fileID: -9117580695321126117, guid: 5e950858e95008a4ca29ca70c69f3a01, type: 3}
  shopPortrait: {fileID: -9117580695321126117, guid: 5e950858e95008a4ca29ca70c69f3a01, type: 3}
  shopUpperBodyPortrait: {fileID: 3409871396524259743, guid: f9ac8fb9332b11c46957b362e661a471, type: 3}
  shopUpperBodyPortraitDimmed: {fileID: -1820050786735437845, guid: 77f9ff1341a1ad14aa5e87303d57a7ff, type: 3}
  alternateName: Operator
  shopDialogue: "\uAFC8\uC5D0 \uC800\uD3B8\uC5D0\uC11C,\n\uB2E4\uC2DC \uB9CC\uB098\uC790."
  codename: Admin
  role: "R&C \uCEF4\uD37C\uB2C8 \uAE30\uC220\uD589\uC815\uCD1D\uBB34"
  faction: "R&C \uCEF4\uD37C\uB2C8"
  height: 164
  birthday: ???
  speciality: "\uB370\uC2A4\uD06C\uC6CC\uD06C"
  weapon: "\uBC31\uC1A1\uC81C K17 \uC790\uB3D9\uAD8C\uCD1D"
  origin: "\uADF8\uB85C\uC2A4\uD504\uB85C\uC774\uC13C, \uBC14\uB974\uC0E4\uC6B0(\uB3C5\uC77C
    \uCE58\uD558 \uD3F4\uB780\uB4DC)"
  bondRecords:
  - description: "\uC774\uB984 : \uCE74\uC2DC\uC544 (Cassia / \uC131\uC528 \uBD88\uC0C1)\r\n\uB098\uC774
      : 21\uC138\r\n\uC2E0\uC7A5/\uCCB4\uC911 : 165cm / 51kg\r\n\uD65C\uB3D9 \uC9C0\uC5ED
      : R&C \uCEF4\uD37C\uB2C8 \uBCF8\uBD80 \uBC0F \uC804\uC120 \uC9C0\uD718\uC18C\r\n\uC18D\uC131
      : \uC9C8\uC11C \uC120 (Lawful Good)\r\n\"\uC5B4\uC11C \uC624\uC138\uC694, \uAC10\uB3C5\uAD00\uB2D8~
      R&C \uCEF4\uD37C\uB2C8\uC5D0 \uC624\uC2E0 \uAC78 \uD658\uC601\uD574\uC694!\r\n\uD6C4\uD6D7,
      \uC55E\uC73C\uB85C \uC81C\uAC00 \uC544\uC8FC \uD1A1\uD1A1\uD788 \uBD80\uB824\uBA39\uC5B4
      \uC904 \uD14C\uB2C8\uAE4C \uB2E8\uB2E8\uD788 \uAC01\uC624\uD558\uC138\uC694?\""
  - description: "R&C \uCEF4\uD37C\uB2C8\uC758 \uAE30\uC220\uD589\uC815\uCD1D\uBB34\uC774\uC790,
      \uC2E0\uC784 \uAC10\uB3C5\uAD00\uC774 \uD68C\uC0AC\uC5D0 \uCCAB\uBC1C\uC744
      \uB514\uB3A0\uC744 \uB54C \uAC00\uC7A5 \uBA3C\uC800 \uB9DE\uC544\uC900 \uC624\uD37C\uB808\uC774\uD130.\r\n\uC5B8\uB73B
      \uBCF4\uBA74 \uC0B4\uB791\uAC70\uB9AC\uB294 \uC18C\uC545\uB9C8 \uAC19\uC740
      \uB9D0\uD22C\uC640 \uC9D3\uAD82\uC740 \uC7A5\uB09C\uC73C\uB85C \uAC10\uB3C5\uAD00\uC744
      \uC950\uB77D\uD3B4\uB77D\uD558\uB294 \uAC83\uCC98\uB7FC \uBCF4\uC774\uC9C0\uB9CC,
      \uC2E4\uC0C1\uC740 \uC0B0\uB354\uBBF8 \uAC19\uC740 \uBCF4\uAE09 \uD488\uC758\uC11C\uC640
      \uC7A5\uBE44 \uBC1C\uC8FC, \uC624\uD37C\uB808\uC774\uD130\uB4E4\uC758 \uC77C\uC815
      \uBC0F \uAE09\uC5EC \uC815\uC0B0\uAE4C\uC9C0 \uB3C4\uB9E1\uC544 \uCC98\uB9AC\uD558\uB294
      \uD68C\uC0AC\uC758 \uD575\uC2EC \uC0B4\uB9BC\uAFBC\uC774\uB2E4."
  - description: "\uD3C9\uC18C\uC5D0\uB294 \uC9C1\uAE09\uC774 \uC9C1\uAE09\uC774\uB77C
      \uB370\uC2A4\uD06C\uC6CC\uD06C\uC5D0 \uD30C\uBB3B\uD600 \uC9C0\uB0B4\uC9C0\uB9CC,
      \uAC70\uB300 \uAE30\uC5C5\uB4E4\uACFC \uC900\uAC70\uB300\uAE30\uC5C5\uC5D0
      \uCE58\uC5EC \uC0C1\uC2DC \uC778\uB825\uB09C\uC778 R&C \uCEF4\uD37C\uB2C8 \uD2B9\uC131\uC0C1
      \uADF8\uB140\uAC00 \uCF58\uC194\uC744 \uC7A1\uC744 \uB54C\uB3C4 \uC788\uB2E4.\n\n\uB2E4\uB978
      \uC624\uD37C\uB808\uC774\uD130\uB4E4\uACFC \uB2EC\uB9AC \uAC01\uC131\uC790\uB3C4,
      \uADF8 \uC804\uC870\uB3C4 \uC5C6\uAE30\uC5D0 \uD2B9\uCD9C\uB09C \uB2A5\uB825\uC740
      \uC5C6\uC9C0\uB9CC, \uCEF4\uD37C\uB2C8 \uC62C\uB4DC\uBE44\uB85C\uC11C\uC758
      \uC5F0\uB95C\uC740 \uBD84\uBA85\uD558\uB2E4."
  - description: "\uADF8\uB140\uC758 \uCD9C\uC2E0\uC9C0\uB294 \uC61B \uD3F4\uB780\uB4DC
      \uC77C\uB300\uB85C \uCD94\uC815\uB418\uB098, \uC778\uC0AC \uAE30\uB85D\uBD80\uC758
      \uACFC\uAC70 \uC774\uB825\uC740 \uCC3D\uC5C5\uC790 \uB808\uBCA0\uCE74\uC5D0
      \uC758\uD574 \uCD5C\uACE0 \uB4F1\uAE09 \uBCF4\uC548(Blackout)\uC73C\uB85C \uC5C4\uACA9\uD788
      \uBD09\uC778\uB418\uC5B4 \uC788\uB2E4.\n\n\uC815\uD669\uC0C1, \uC81C 5\uCC28
      \uBC14\uB974\uC0E4\uBC14 \uBD09\uAE30\uC758 \uD63C\uB780\uC0C1 \uC18D\uC5D0\uC11C
      \uD63C\uC790 \uB0A8\uACA8\uC838, \uCEF4\uD37C\uB2C8\uAE4C\uC9C0 \uD758\uB7EC\uB4E4\uC5B4\uC654\uB2E4\uB294
      \uD574\uC11D\uC774 \uC6B0\uC138\uD558\uB2E4.\n\n\uB2E4\uB9CC, \uBCF8\uC778\uC740
      \uBBFC\uC871\uC8FC\uC758\uC801\uC778 \uC815\uCCB4\uC131\uBCF4\uB2E4\uB294 \uC560\uC0AC\uC2EC\uC774
      \uAC15\uD55C \uD3B8\uC774\uB77C \uACFC\uAC70\uB97C \uCE90\uBB3B\uAE30\uB3C4
      \uC27D\uC9C0 \uC54A\uC740 \uD3B8.\n\n......\uADF8\uB140\uC5D0\uAC8C, \uC774
      \uCEF4\uD37C\uB2C8\uC57C\uB9D0\uB85C '\uC9D1'\uC778 \uAC83\uC77C \uBFD0\uC778
      \uC774\uC57C\uAE30."
  - description: "\uC790\uC544\uC790\uC544, \uC7AC\uBC0C\uAC8C \uC77D\uC5C8\uC5B4?\n\uC544\uD558\uD558,
      \uC544\uB9C8 \uC774\uAC78 \uC77D\uACE0 \uC788\uB294 \uB2F9\uC2E0\uC740 \uBC14\uBCF4\uAC19\uC740
      \uC5BC\uAD74\uC77C \uAC70\uC57C.,\n\n\uC774\uC81C... \uAC10\uB3C5\uAD00 \uC55E\uC5D0\uC11C\uB294
      \uC18C\uC545\uB9C8 \uD749\uB0B4 \uAC19\uC740 \uAC74 \uB354 \uBABB \uB0B4\uACA0\uC5B4.\r\n\n\uCC98\uC74C\uC5D4
      \uB180\uB824\uC8FC\uB294 \uAC8C \uC7AC\uBBF8\uC788\uC5C8\uC744 \uBFD0\uC778\uB370...
      \uC5B4\uB290\uC0CC\uAC00 \uB0B4 \uBAA8\uB4E0 \uC11C\uB958\uC758 \uB05D\uC5D0\uB3C4,
      \uBAA8\uB4E0 \uAE30\uB3C4\uC758 \uB05D\uC5D0\uB3C4 \uB2F9\uC2E0\uC774 \uC788\uC5C8\uC5B4.\n\uC624\uD37C\uB808\uC774\uC774\uD130\uB4E4\uC774\uB77C\uBA74
      \uBAA8\uB97C\uAE4C... \uB2F9\uC2E0\uC758 \uC9C1\uC18D\uC0C1\uAD00\uC740 \uB098\uB2C8\uAE4C,
      \uB0B4 \uB9D0\uC744 \uC798 \uB4E4\uC5B4\uC57C\uACA0\uC9C0? \uD050\uD6C4\uD6C4...\n\r\n......\uADF8\uB7EC\uB2C8\uAE4C
      \uB9D0\uC774\uC9C0, \uCEF4\uD37C\uB2C8\uC5D0 \uD3C9\uC0DD \uB0A8\uC544\uC918?
      \uCC38\uACE0\uB85C \uC120\uD0DD\uAD8C\uC740 \uC5C6\uC73C\uB2C8\uAE4C?"
