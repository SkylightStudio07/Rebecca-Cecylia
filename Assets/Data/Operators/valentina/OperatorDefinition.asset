  m_Name: OperatorDefinition
  m_EditorClassIdentifier: Assembly-CSharp::RCCom.Definitions.Operator.OperatorDefinition
  operatorId: valentina
  displayName: "\uBC1C\uB80C\uD2F0\uB098"
  playStyleDescription: "\uBA54\uAC00\uCF54\uD504 \uD654\uD559 \uD3D0\uAE30\uBB3C
    \uD2B9\uC218 \uCC98\uB9AC\uBC18 \uCD9C\uC2E0\uC758 \uD654\uD559\uACF5\uD559 \uD3ED\uD30C
    \uC804\uBB38\uAC00"
  selectionPortrait: {fileID: 21300000, guid: 20c5d73063fa94440b247815c6092002, type: 3}
  managementPortrait: {fileID: 21300000, guid: 35830e648ffccc34792e68c5f2cc188b, type: 3}
  shopPortrait: {fileID: 21300000, guid: 35830e648ffccc34792e68c5f2cc188b, type: 3}
  shopUpperBodyPortrait: {fileID: 21300000, guid: 21815ddb252e79445b2ff223355fb5c0, type: 3}
  shopUpperBodyPortraitDimmed: {fileID: 21300000, guid: 89a7756530a82de41ade782e1c214686, type: 3}
  alternateName: Mad Scientist
  shopDialogue: "\uC548\uC804 \uADDC\uC815? \uADF8\uB7F0 \uAC74 \uC2E4\uD5D8\uC2E4
    \uCC45\uC0C1\uC5D0\uB098 \uAF42\uC544\uB450\uB77C\uACE0."
  codename: Hazard Chemist
  role: "R&C \uCEF4\uD37C\uB2C8 \uD654\uD559\uBCD1\uAE30 \uAC1C\uBC1C\uBC18"
  faction: "R&C \uCEF4\uD37C\uB2C8 (\u524D \uBA54\uAC00\uCF54\uD504 \uD654\uD559\uD3D0\uAE30\uBB3C
    \uCC98\uB9AC\uBC18)"
  height: 171cm
  birthday: "11\uC6D4 5\uC77C"
  speciality: "\uD654\uD559\uACF5\uD559, \uD3ED\uBC1C\uBB3C \uBC30\uD569"
  weapon: "\uAC1C\uC870 \uC18C\uC774\uD0C4 \uBC1C\uC0AC\uAD00 '\uC0B4\uB77C\uB9CC\uB354'"
  origin: "\uB8E8\uC774\uC9C0\uC560\uB098 \uAC78\uD504 \uC5F0\uC548, \uBBF8\uD569\uC911\uAD6D"
  bondRecords:
  - description: "\uC774\uB984 : \uBC1C\uB80C\uD2F0\uB098 \uD06C\uB85C\uD504\uD2B8
      (Valentina Croft)\r\n\uB098\uC774 : 27\uC138\r\n\uC2E0\uC7A5/\uCCB4\uC911 :
      171cm / 58kg\r\n\uD65C\uB3D9 \uC9C0\uC5ED : R&C \uCEF4\uD37C\uB2C8 \uD654\uD559\uBCD1\uAE30
      \uC5F0\uAD6C\uB3D9 \uBC0F \uCD5C\uC804\uC120 \uD3ED\uD30C \uAC70\uC810\r\n\uC18D\uC131
      : \uD63C\uB3C8 \uC120 (Chaotic Good)\r\n\"\uD5E4\uC5D0~ \uB124\uAC00 \uC18C\uBB38\uC758
      \uC2E0\uC784 \uAC10\uB3C5\uAD00\uC774\uC57C? \uD654\uD559 \uD3D0\uAE30\uBB3C
      \uCC98\uB9AC\uBC18 \uCD9C\uC2E0 \uBC1C\uB80C\uD2F0\uB098 \uD06C\uB85C\uD504\uD2B8\uB2E4.
      \uB0B4 \uC2AC\uB7EC\uC9C0 \uD0F1\uD06C\uC5D0 \uBD88\uB9CC \uBD99\uC5EC\uC8FC\uBA74
      \uC804\uC7A5\uC758 \uCC0C\uAEBC\uAE30\uB4E4\uC740 \uD754\uC801\uB3C4 \uC5C6\uC774
      \uD0DC\uC6CC\uC904\uAC8C!\""
  - description: "\uBA54\uAC00\uCF54\uD504 \uD654\uD559 \uD3D0\uAE30\uBB3C \uD2B9\uC218
      \uCC98\uB9AC\uBC18 \uCD9C\uC2E0\uC758 \uD654\uD559 \uC5D4\uC9C0\uB2C8\uC5B4\uC774\uC790
      \uD3ED\uD30C \uC804\uBB38\uAC00. \uC0B0\uC5C5 \uD3D0\uAE30\uBB3C\uC744 \uC548\uC804\uD558\uAC8C
      \uBB34\uD574\uD654\uD558\uB294 \uAC83\uC774 \uC6D0\uB798 \uC784\uBB34\uC600\uC9C0\uB9CC,
      \uC815\uC791 \uADF8\uB140\uC758 \uD765\uBBF8\uB97C \uB048 \uAC74 '\uC5B4\uB5BB\uAC8C
      \uD558\uBA74 \uB354 \uD654\uB824\uD558\uACE0 \uC644\uBCBD\uD558\uAC8C \uD0DC\uC6CC
      \uC5C6\uC568 \uC218 \uC788\uB294\uAC00'\uC600\uB2E4.\r\n\uC9C0\uAE08\uC740
      R&C \uCEF4\uD37C\uB2C8\uC758 \uD654\uD559\uBCD1\uAE30 \uAC1C\uBC1C\uBC18\uC5D0
      \uC18C\uC18D\uB418\uC5B4, \uC0B0\uC131 \uC2AC\uB7EC\uC9C0\uC640 \uC18C\uC774\uD0C4\uC744
      \uC870\uD569\uD55C \uC790\uC2E0\uB9CC\uC758 \uD654\uB825\uC744 \uC804\uC7A5\uC5D0\uC11C
      \uB9C8\uC74C\uAECF \uD3BC\uCE58\uACE0 \uC788\uB2E4."
  - description: "\uB4F1\uC5D0 \uC9CA\uC5B4\uC9C4 \uACE0\uC555 \uD0F1\uD06C\uC5D0\uB294
      \uBC30\uD569 \uBE44\uC728\uC5D0 \uB530\uB77C \uBD80\uC2DD\uC131\uACFC \uAC10\uC18D
      \uD6A8\uACFC\uAC00 \uB2EC\uB77C\uC9C0\uB294 \uD2B9\uC81C \uC2AC\uB7EC\uC9C0\uAC00
      \uC800\uC7A5\uB418\uC5B4 \uC788\uC73C\uBA70, \uC18C\uC774\uD0C4 \uBC1C\uC0AC\uAD00\uC740
      \uBB3C\uB85C\uB3C4 \uAEBC\uC9C0\uC9C0 \uC54A\uB294 \uB098\uD504\uD0C0 \uACC4\uC5F4
      \uD654\uD569\uBB3C\uC744 \uC3D8\uC544\uB0B8\uB2E4.\r\n\uBCF8\uC778 \u66F0,
      \uD30C\uAD34\uB294 \uADF8\uC800 \uBD80\uC0B0\uBB3C\uC77C \uBFD0\uC774\uACE0
      \uC9C4\uC9DC \uBAA9\uC801\uC740 '\uC644\uBCBD\uD55C \uD654\uD559\uC801 \uC5F0\uC1C4
      \uBC18\uC751'\uC744 \uC644\uC131\uD558\uB294 \uAC83\uC774\uB77C\uB098. \uC548\uC804
      \uADDC\uC815 \uC704\uBC18 \uACBD\uACE0\uC7A5\uC740 \uC774\uBBF8 \uC11C\uB78D
      \uD558\uB098\uB97C \uAC00\uB4DD \uCC44\uC6E0\uB2E4."
  - description: "\uBA54\uAC00\uCF54\uD504 \uC2DC\uC808, \uADF8\uB140\uAC00 \uBAB8\uB2F4\uC558\uB358
      \uCC98\uB9AC\uBC18\uC740 \uD45C\uBA74\uC801\uC73C\uB85C\uB294 \uC0B0\uC5C5
      \uD3D0\uAE30\uBB3C \uBB34\uD574\uD654\uB97C \uB2F4\uB2F9\uD588\uC9C0\uB9CC
      \uC2E4\uC0C1\uC740 \uB4B7\uB3C8\uC744 \uBC1B\uACE0 \uC720\uD574\uBB3C\uC9C8\uC744
      \uBD88\uBC95 \uD22C\uAE30\uD558\uB294 \uBD80\uC11C\uC600\uB2E4.\r\n\uB3D9\uB8CC\uB4E4\uC774
      \uC99D\uAC70 \uC778\uBA78\uC744 \uC704\uD574 \uC800\uC7A5\uACE0 \uC804\uCCB4\uB97C
      \uD3ED\uD30C\uD558\uB824\uB358 \uADF8\uB0A0, \uBC1C\uB80C\uD2F0\uB098\uB294
      \uADF8 \uD3ED\uBC1C\uC744 \uC624\uD788\uB824 '\uB354 \uC644\uBCBD\uD558\uAC8C'
      \uAC1C\uC870\uD574 \uC790\uC2E0\uC744 \uC740\uD3D0\uD558\uACE0 \uD640\uB85C
      \uC0B4\uC544\uB0A8\uC558\uB2E4 \u2014 \uADF8\uB9AC\uACE0 \uADF8 \uC0AC\uAC74\uC774
      \uADF8\uB140\uB97C \uC9C4\uC9DC \uD3ED\uD30C\uAD11\uC73C\uB85C \uB9CC\uB4E4\uC5C8\uB2E4.\r\n\uBA54\uAC00\uCF54\uD504\uC5D0\uC11C
      \uC704\uD5D8\uC778\uBB3C\uB85C \uC218\uBC30\uB41C \uADF8\uB140\uB97C \uAC70\uB454
      \uAC83\uC774 \uBC14\uB85C R&C \uCEF4\uD37C\uB2C8\uC600\uB2E4."
  - description: "\uC790, \uC544~ \uD574\uBD10. \uC601\uC591\uC81C \uCEA1\uC290\uC774\uC57C...
      \uB77C\uACE0 \uD558\uBA74 \uBBFF\uC5B4\uC904 \uAC70\uC57C? \uD06D\uD06D, \uB18D\uB2F4\uC774\uACE0.\r\n\uB0B4
      \uC2EC\uC7A5\uC758 \uAE30\uD3ED \uC2A4\uC704\uCE58, \uC644\uC804\uD788 \uB124
      \uC190\uC5D0 \uC950\uC5EC\uC904\uAC8C. \uB124\uAC00 \uB2F9\uAE30\uBA74 \uB09C
      \uC6B0\uC8FC \uB05D\uAE4C\uC9C0\uB77C\uB3C4 \uD130\uC838\uB098\uAC08 \uC900\uBE44\uAC00
      \uB418\uC5B4 \uC788\uC5B4.\r\n\uC138\uC0C1 \uBAA8\uB4E0 \uBB3C\uC9C8\uC740
      \uC0AD\uACE0 \uBD80\uC2DD\uB418\uC9C0\uB9CC, \uB108\uC640 \uB098\uC758 \uD654\uD559
      \uACB0\uD569\uB9CC\uC740 \uC601\uC6D0\uD788 \uC548 \uAE68\uC838. \uC0AC\uB791\uD574,
      \uAC10\uB3C5\uAD00\u2665"
  playerData:
    maxHealth: 30
    moveSpeed: 5
    hitInvulnerabilityDuration: 0
    attackDamage: 5
